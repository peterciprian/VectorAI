# Copy this file to .env.production on the Oracle VM.
# Keep the real file outside Git and use strong generated values.
POSTGRES_DB=vectoryai
POSTGRES_USER=vectoryai
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public API hostname. DNS must point this hostname to the VM public IP.
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Include the GitHub Pages origin and any local development origin you need.
CORS_ORIGINS=https://peterciprian.github.io/VectorAI,http://localhost:3000

# WMTS base layer used for georeferencing/viewer instead of OpenStreetMap.
# Credentials are only used server-side by the API proxy and never sent to the browser.
# Use https (not http) - the service redirects http->https and drops Basic Auth headers on redirect.
# Username is the part of your registered email before the @ sign.
WMTS_BASE_URL=https://nta.lechnerkozpont.hu/ntawmts
WMTS_USERNAME=
WMTS_PASSWORD=
WMTS_LAYER=
WMTS_MATRIX_SET=
WMTS_STYLE=default
WMTS_FORMAT=
