POSTGRES_DB=vectoryai
POSTGRES_USER=vectoryai
POSTGRES_PASSWORD=vectoryai_dev
DATABASE_URL=postgresql+asyncpg://vectoryai:vectoryai_dev@localhost:5432/vectoryai
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
STORAGE_ROOT=./storage/projects
CORS_ORIGINS=http://localhost:3000

# WMTS base layer used for georeferencing/viewer instead of OpenStreetMap.
# Credentials are only used server-side by the API proxy and never sent to the browser.
# Use https (not http) - the service redirects http->https and drops Basic Auth headers on redirect.
# Username is the part of your registered email before the @ sign.
WMTS_BASE_URL=https://nta.lechnerkozpont.hu/ntawmts
WMTS_USERNAME=
WMTS_PASSWORD=
# Optional overrides; if left blank the API auto-detects the layer/format from GetCapabilities (NTA: layer=nta10, matrixSet=EOV, format=image/jpeg).
WMTS_LAYER=
WMTS_MATRIX_SET=
WMTS_STYLE=default
WMTS_FORMAT=
